---
import GitHub from "./icons/GitHub.astro";
import NextJS from "./icons/NextJS.astro";
import NestJS from "./icons/NestJS.astro";
import Tailwind from "./icons/Tailwind.astro";
import Link from "./icons/Link.astro";
import Kotlin from "./icons/Kotlin.astro";
import Swift from "./icons/Swift.astro";
import Express from "./icons/Express.astro";
import LinkButton from "./LinkButton.astro";

const TAGS = {
  NEXT: {
    name: "Next.js",
    class: "bg-black text-white",
    icon: NextJS,
  },
  NEST: {
    name: "Nest.js",
    class: "bg-gray-800 text-white",
    icon: NestJS,
  },
  TAILWIND: {
    name: "Tailwind CSS",
    class: "bg-[#003159] text-white",
    icon: Tailwind,
  },
  SWIFT: {
    name: "Swift",
    class: "bg-[#F05138] text-white",
    icon: Swift,
  },
  KOTLIN: {
    name: "Kotlin",
    class: "bg-gray-900 text-white",
    icon: Kotlin,
  },
  EXPRESS: {
    name: "Express",
    class: "bg-gray-700 text-white",
    icon: Express,
  },
};
const PROJECTS = [
  {
    title: "Ruty - Movilidad que nos une",
    description:
      "Plataforma de movilidad con dos apps móviles publicadas: Ruty, para que los pasajeros soliciten viajes con conductores de confianza, y Ruty Driver, para que los conductores gestionen sus servicios, ganancias y documentos. Disponibles para iOS y Android.",
    link: "https://rutyco.com/es",
    image: "/projects/ruty.jpg",
    tags: [TAGS.SWIFT, TAGS.KOTLIN, TAGS.EXPRESS],
    stores: [
      { href: "https://apps.apple.com/co/app/ruty/id6754960790", label: "Ruty (App Store)" },
    ],
  },
  {
    title: "E-Commerce - Microservices Architecture",
    description:
      "Plataforma de comercio electrónico escalable diseñada bajo una arquitectura de microservicios. Implementa un frontend de alto rendimiento con Next.js y un backend robusto con Nest.js, garantizando modularidad y despliegue independiente.",
    // link: "https://tu-demo.com/", // Actualiza tu link
    // github: "https://github.com/tu-usuario/tu-repo", // Actualiza tu repo
    image: "/projects/E-commerce.jpg",
    tags: [TAGS.NEXT, TAGS.NEST, TAGS.TAILWIND], // Añade tags si los tienes
  },
  {
  title: "My Notes - Fullstack Management App",
  description:
    "Aplicación integral de gestión de notas diseñada para la productividad. Implementa un sistema de persistencia seguro con Nest.js en el backend y una interfaz reactiva optimizada con Next.js y Tailwind CSS.",
  link: "https://notes-gold-five-22.vercel.app", // Tu link actual
  github: "https://github.com/villegas07/Notes.git",
  image: "/projects/mynotes.jpg", // Recuerda cambiar esta imagen luego
  tags: [TAGS.NEXT, TAGS.NEST, TAGS.TAILWIND],
},
];
---

<div class="flex flex-col gap-y-16">
  {
    PROJECTS.map(({ image, title, description, tags, link, github, stores }) => (
      <article class="flex flex-col space-x-0 space-y-8 group md:flex-row md:space-x-8 md:space-y-0">
        <div class="w-full md:w-1/2">
          <div class="relative flex flex-col items-center col-span-6 row-span-5 gap-8 transition duration-500 ease-in-out transform shadow-xl overflow-clip rounded-xl sm:rounded-xl md:group-hover:-translate-y-1 md:group-hover:shadow-2xl lg:border lg:border-gray-800 lg:hover:border-gray-700 lg:hover:bg-gray-800/50">
            <img
              alt={title}
              class="object-cover object-top w-full h-56 transition duration-500 sm:h-full md:scale-110 md:group-hover:scale-105"
              loading="lazy"
              src={image}
            />
          </div>
        </div>

        <div class="w-full md:w-1/2 md:max-w-lg">
          <h3 class="text-2xl font-bold text-gray-800 dark:text-gray-100">
            {title}
          </h3>
          <div class="flex flex-wrap mt-2">
            <ul class="flex flex-row mb-2 gap-x-2">
              {tags.map((tag) => (
                <li>
                  <span
                    class={`flex gap-x-2 rounded-full text-xs ${tag.class} py-1 px-2 `}
                  >
                    {tag.icon && <tag.icon class="size-4" />}
                    {tag.name}
                  </span>
                </li>
              ))}
            </ul>

            <div class="mt-2 text-gray-700 dark:text-gray-400">
              {description}
            </div>
            <footer class="flex flex-wrap items-end justify-start mt-4 gap-4">
              {stores?.map((store) => (
                <LinkButton href={store.href}>
                  <Link class="size-4" />
                  {store.label}
                </LinkButton>
              ))}
              {github && (
                <LinkButton href={github}>
                  <GitHub class="size-6" />
                  Code
                </LinkButton>
              )}
              {link && (
                <LinkButton href={link}>
                  <Link class="size-4" />
                  Preview
                </LinkButton>
              )}
            </footer>
          </div>
        </div>
      </article>
    ))
  }
</div>
